# =============================================================================
# GLPConvert — local secrets template (COMMITTED — safe to push)
# =============================================================================
# 1) Copy this file to `.env.local` (gitignored):
#      cp env.local.template .env.local
# 2) Replace every placeholder below with values from Supabase / Stripe / Resend.
# 3) Never commit `.env.local`.
# 4) Paste the SAME keys into Vercel → Project → Settings → Environment Variables
#    (Production + Preview + Development unless you split on purpose).
#
# Production URL for this repo (default): https://glp-convert.vercel.app
#   → NEXT_PUBLIC_APP_URL in Vercel = that URL (see docs/VERCEL_CANONICAL_URL.md if different)
#   → Stripe webhook URL = https://glp-convert.vercel.app/api/stripe/webhook
#
# Full paste tables: docs/ENV_VERCEL_AND_LOCAL.md
# APIs used: docs/GLPCONVERT_APIS_AND_INTEGRATIONS.md
# =============================================================================

# --- App (local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERTICAL=glp
NEXT_PUBLIC_BRAND_NAME=GLPConvert

# --- Generate locally: openssl rand -hex 32 (two different values) ---
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_1
ADMIN_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32_2

# --- Supabase: Dashboard → Project Settings → API ---
# Project URL → https://xxxxxxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# service_role (secret) — long eyJ... JWT — NEVER expose to browser / NEVER NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_secret_here

# --- Stripe: Dashboard → Developers → API keys (start with TEST keys) ---
# Secret key → sk_test_... or sk_live_...
STRIPE_SECRET_KEY=sk_test_paste_here
# Optional alias some routes read:
STRIPE_LIVE_SECRET_KEY=
# Publishable → pk_test_... — also used client-side via NEXT_PUBLIC_
STRIPE_PUBLISHABLE_KEY=pk_test_paste_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_paste_here

# Products → copy Price IDs (price_...)
STRIPE_PRICE_MONTHLY_99=price_paste_monthly_here
STRIPE_PRICE_SETUP_399=price_paste_setup_here

# Developers → Webhooks → your endpoint → Signing secret whsec_...
# Use local Stripe CLI or production URL https://YOUR_DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_paste_after_creating_endpoint

# --- Resend (optional until email works): resend.com → API Keys ---
RESEND_API_KEY=re_paste_here

# --- Sentry (optional): sentry.io → Project Settings → Client Keys (DSN) ---
# Same DSN string in both (one project). See docs/SENTRY_GLPCONVERT.md
# SENTRY_DSN=https://...@o....ingest.us.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.us.sentry.io/...
# Local/prod test page + /api/sentry-test: set to 1 only when verifying (see doc)
# NEXT_PUBLIC_SENTRY_ENABLE=1

# --- Optional analytics (intake) ---
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Optional: cap Supabase fetch timeout (ms) ---
# SUPABASE_FETCH_TIMEOUT_MS=12000
